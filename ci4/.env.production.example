#--------------------------------------------------------------------
# CareSync - LIVE server settings (InfinityFree)
# Copy this file to ".env" ON THE SERVER, fill in every ___ value, and
# never share the finished .env.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://___your-domain___/'
app.appTimezone = 'Asia/Manila'
app.forceGlobalSecureRequests = true

# Database - copy from the InfinityFree panel (MySQL Databases)
database.default.hostname = ___sqlXXX.infinityfree.com___
database.default.database = ___if0_XXXXXXXX_caresync___
database.default.username = ___if0_XXXXXXXX___
database.default.password = ___NEW password___
database.default.DBDriver = MySQLi
database.default.port = 3306

# Government ID verification (Anthropic API key)
governmentidverification.anthropicApiKey = '___'

# Email for temporary passwords and password resets (use a Gmail app password
# or your host's SMTP). Without these, emails are not sent.
email.fromEmail = 'kaagapay00@gmail.com'
email.fromName = 'Kaagapay CareSync'
email.protocol = 'smtp'
email.SMTPHost = 'smtp.gmail.com'
email.SMTPUser = 'kaagapay00@gmail.com'
email.SMTPPass = '___app password___'
email.SMTPPort = 587
email.SMTPCrypto = 'tls'

# ONE-TIME database update (no command line on InfinityFree).
# 1) Put a long random value here, 2) open https://___your-domain___/migrate/THAT-VALUE
# once, 3) DELETE this line again. Leave it out the rest of the time.
# app.migrateKey = '___at-least-16-random-characters___'
