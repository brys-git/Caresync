#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
app.baseURL = 'http://localhost/caresync/ci4/public/'
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = kaagapay_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# EMAIL (panel brief section 9: notification delivery)
#--------------------------------------------------------------------
# Fill these in with real values to enable email delivery on
# notifications (App\Services\NotificationService::notify() with
# $sendEmail = true). Left commented out = email sending is skipped
# (logged, not fatal) - see NotificationService::sendEmail().

# email.fromEmail = 'noreply@example.com'
# email.fromName = 'CareSync'
# email.protocol = 'smtp'
# email.SMTPHost = ''
# email.SMTPUser = ''
# email.SMTPPass = ''
# email.SMTPPort = 587
# email.SMTPCrypto = 'tls'

#--------------------------------------------------------------------
# SEMAPHORE SMS (panel brief section 9: notification delivery)
#--------------------------------------------------------------------
# https://semaphore.co - fill in your API key to enable SMS delivery
# on notifications (NotificationService::notify() with $sendSms =
# true). Left blank = SMS sending is skipped (logged, not fatal) - see
# App\Services\SmsService.

# semaphore.apiKey = ''
# semaphore.senderName = ''

#--------------------------------------------------------------------
# GOVERNMENT ID VERIFICATION (Claude vision, via the Anthropic API)
#--------------------------------------------------------------------
# https://console.anthropic.com/ - fill in your API key to enable ID
# verification on registration forms. Left blank = every submission is
# marked 'needs_review' for manual staff follow-up instead of failing -
# see App\Services\GovernmentIdVerificationService.

# governmentId.anthropicApiKey = ''
